# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# App
APP_NAME=Ethiopian Job Platform
APP_ENV=development
DEBUG=True
SECRET_KEY=change-me
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobplatform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (sign up for Resend - free tier)
EMAIL_FROM=no-reply@yourdomain.com
RESEND_API_KEY=your-resend-api-key

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Sentry
SENTRY_DSN=

# Firebase Cloud Messaging (leave empty to disable push notifications)
FIREBASE_CREDENTIALS_PATH=
